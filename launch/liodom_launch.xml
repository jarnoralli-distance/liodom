<launch>
  <!-- Frame parameters -->
  <arg name="viz" default="false" />
  <arg name="mapping" default="false" />
  <arg name="frame_id" default="01" />
  <arg name="origin_coords_lanelet_lat" default="48.97253396005" />
  <arg name="origin_coords_lanelet_lon" default="8.4785980847297" />
  <arg name="angle_lanelet_correction" default="16.0" />

  
  <!-- Lanet parameters -->
  <arg name="type" default="liodom" />
  <arg name="pose_history_size" default="1" />
  <arg name="use_icp_optimization" default="false" />
  <arg name="use_normal_shooting" default="true" />
  <arg name="icp_error_threshold" default="1.0" />
  <arg name="knn_neighbors" default="50" />
  <arg name="valid_correspondence_threshold" default="0.6" />

  <!-- Liodom parameters -->
  <arg name="scan_regions" default="8" />
  <arg name="edges_per_region" default="10" />



  <!-- Liodom -->
  <node pkg="liodom"
        exec="liodom_node"
        name="liodom"
        namespace="liodom"
        output="screen"
        respawn="false">

    <param name="min_range" value="3.0" />
    <param name="max_range" value="75.0" />
    <param name="lidar_type" value="0" />
    <param name="scan_lines" value="64" />
    <param name="scan_regions" value="$(var scan_regions)" />
    <param name="edges_per_region" value="$(var edges_per_region)" />
    <param name="prev_frames" value="15" />
    <param name="fixed_frame" value="odom" />
    <param name="base_frame" value="base_link" />
    <param name="laser_frame" value="velo_link" />
    <param name="use_imu" value="false" />
    <param name="save_results" value="true" />    
    <param name="save_results_dir" value="/home/joaquinecc/Documents/ros_projects/results/$(var type)/$(var frame_id)/" />
    <param name="mapping" value="$(var mapping)" />
    <param name="publish_tf" value="false" />
    <param name="use_sim_time" value="true"/>

    <remap from="points" to="/kitti/velo/pointcloud" />
    <remap from="imu" to="/kitti/oxts/imu" />
    <remap from="map" to="/liodom_mapper/map_local" />

    <!-- ICP optimization parameters -->
    <param name="use_icp_optimization" value="$(var use_icp_optimization)" />
    <param name="use_normal_shooting" value="$(var use_normal_shooting)" />
    <param name="pose_history_size" value="$(var pose_history_size)" />
    <param name="knn_neighbors" value="$(var knn_neighbors)" />
    <param name="icp_error_threshold" value="$(var icp_error_threshold)" />
    <param name="valid_correspondence_threshold" value="$(var valid_correspondence_threshold)" />
    <!-- Lanelet parameters -->
    <param name="map_lanelet_path" value="/home/joaquinecc/Documents/dataset/kitti/dataset/map/$(var frame_id)/lanelet2_seq_$(var frame_id).osm"/>
    
    <param name="origin_coords_lanelet_lat" value="$(var origin_coords_lanelet_lat)"/>
    <param name="origin_coords_lanelet_lon" value="$(var origin_coords_lanelet_lon)"/>
    <param name="angle_lanelet_correction" value="$(var angle_lanelet_correction)"/>

  </node>

  <!-- Mapping, if required -->
  <group if="$(var mapping)">
    <node pkg="liodom"
        exec="liodom_mapping"
        name="liodom_mapper"
        namespace="liodom_mapper"
        output="screen"
        respawn="false">

      <param name="voxel_xysize" value="30.0" />
      <param name="voxel_zsize" value="35.0" />
      <param name="resolution" value="0.4" />    
      <param name="cells_xy" value="3" />
      <param name="cells_z" value="2" />
      <param name="fixed_frame" value="odom" />
      <param name="base_frame" value="velo_link" />
      <param name="use_sim_time" value="true"/>
      
      <remap from="points" to="/liodom/edges" />
    
    </node>
  </group>


  <group if="$(var viz)">
    <node exec="rviz2" name="rviz2" pkg="rviz2" args="-d $(find-pkg-share liodom)/rviz/liodom.rviz">
      <param name="use_sim_time" value="true"/>
    </node>
  </group>

</launch>
